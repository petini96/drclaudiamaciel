# HOMOLOGACAO — copie para .env no diretorio de homologacao do servidor.
#
# Tudo aqui e diferente de producao de proposito: projeto, container, tag de
# imagem e porta separados garantem que subir homologacao nunca toque no site
# que esta no ar.
COMPOSE_PROJECT_NAME=drclaudiamaciel-hom
CONTAINER_NAME=drclaudiamaciel-site-hom
IMAGE_TAG=hom

SITE_URL=https://hom.drclaudiamaciel.com.br
SITE_ENV=hom
HOST_PORT=8092

# Measurement ID da propriedade GA4 de HOMOLOGACAO — precisa ser uma propriedade
# DIFERENTE da de producao, senao os eventos de teste entram nos relatorios
# reais. Com SITE_ENV=hom o build ainda liga debug_mode, o que faz os eventos
# aparecerem no DebugView do GA4 em tempo real.
GA_MEASUREMENT_ID=
