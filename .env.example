# PRODUCAO — copie para .env no servidor (o .env nao vai para o git).
COMPOSE_PROJECT_NAME=drclaudiamaciel
CONTAINER_NAME=drclaudiamaciel-site
IMAGE_TAG=latest

SITE_URL=https://drclaudiamaciel.com.br
SITE_ENV=prod
HOST_PORT=8091

# Measurement ID da propriedade GA4 de PRODUCAO (Admin > Fluxos de dados).
# Deixe vazio para publicar sem nenhum Google Analytics.
GA_MEASUREMENT_ID=
